---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: 'website' | 'article';

  theme?: 'paper' | 'dark';
  accent?: 'brand' | 'legal' | 'research' | 'avin' | 'evidence' | 'lab';

  eyebrow?: string;
  heading: string;
  lead?: string;

  width?: 'article' | 'standard' | 'wide';
  showBack?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  theme = 'paper',
  accent = 'legal',
  eyebrow,
  heading,
  lead,
  width = 'standard',
  showBack = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType={ogType}
>
  <div
    class="page-shell"
    data-theme={theme}
    data-accent={accent}
  >
    <main class:list={['page-container', `width-${width}`]}>
      {
        showBack && (
          <a class="back" href="/">
            ← Back to home
          </a>
        )
      }

      {
        eyebrow && (
          <p class="eyebrow">
            {eyebrow}
          </p>
        )
      }

      <slot name="pre-heading" />

      <h1>{heading}</h1>

      {
        lead && (
          <p class="lead">
            {lead}
          </p>
        )
      }

      <slot name="header-extra" />

      <slot />
    </main>
  </div>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html),
    :global(body) {
      margin: 0;
      min-height: 100%;
    }

    :global(body) {
      font-family: Arial, Helvetica, sans-serif;
    }

    .page-shell {
      min-height: 100vh;
      background: var(--page-bg);
      color: var(--page-text);
    }

    .page-container {
      width: 90%;
      margin: 0 auto;
      padding: 3rem 0 6rem;
    }

    .width-article {
      max-width: 780px;
    }

    .width-standard {
      max-width: 900px;
    }

    .width-wide {
      max-width: 1000px;
    }

    .back {
      display: inline-block;
      margin-bottom: 3rem;
      color: var(--page-link);
      text-decoration: none;
      font-weight: 700;
    }

    .back:hover,
    .back:focus-visible {
      text-decoration: underline;
    }

    .eyebrow {
      margin: 0 0 1rem;
      color: var(--eyebrow-color, var(--accent));
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.18em;
    }

    h1 {
      margin: 0 0 1.5rem;
      font-size: clamp(2.8rem, 8vw, 5.5rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .lead {
      max-width: 780px;
      margin: 0 0 2.5rem;
      color: var(--page-muted);
      font-size: 1.2rem;
      line-height: 1.7;
    }
  </style>
</BaseLayout>