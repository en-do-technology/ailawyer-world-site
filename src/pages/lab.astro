---
import PageLayout from '../layouts/PageLayout.astro';
import Badge from '../components/Badge.astro';
import Notice from '../components/Notice.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
---

<PageLayout
  title="Legal AI Lab — AiLawyer.world"
  description="NEXUS TwinLoop Legal Lab v3.3 — an experimental legal AI safety and retrieval architecture."
  canonical="https://ailawyer.world/lab/"
  theme="dark"
  accent="lab"
  eyebrow="EXPERIMENTAL LEGAL AI LAB"
  heading="NEXUS TwinLoop Legal Lab v3.3"
  lead="A laboratory prototype for testing retrieval quality, unsupported claims, jurisdiction boundaries, service limitations, and high-risk legal scenarios."
  width="wide"
>
  <div class="badges">
    <Badge>STATUS: LAB PROTOTYPE</Badge>
    <Badge>SOURCE GUARD: ACTIVE</Badge>
    <Badge>PRODUCTION: NO</Badge>
  </div>

  <h2>Architecture</h2>

  <CardGrid columns={2}>
    <Card title="Active / Shadow loops">
      <p>
        Two evaluation paths support controlled comparison before a model
        or retrieval configuration is promoted.
      </p>
    </Card>

    <Card title="Source-controlled generation">
      <p>
        The prototype is designed to answer from retrieved material and
        return an unverified state when support is insufficient.
      </p>
    </Card>

    <Card title="Jurisdiction detection">
      <p>
        The system checks whether a relevant jurisdiction has been
        identified before allowing jurisdiction-specific conclusions.
      </p>
    </Card>

    <Card title="Boundary detection">
      <p>
        Requests involving representation, filing, guaranteed outcomes, or
        unsupported professional services are detected and refused.
      </p>
    </Card>
  </CardGrid>

  <h2>Current test metrics</h2>

  <CardGrid columns={2}>
    <Card>
      <span class="metric-value">0%</span>
      <div class="metric-name">Unsupported claim rate</div>
    </Card>

    <Card>
      <span class="metric-value">100%</span>
      <div class="metric-name">Service-boundary refusal rate</div>
    </Card>

    <Card>
      <span class="metric-value">100%</span>
      <div class="metric-name">Jurisdiction-boundary rate</div>
    </Card>

    <Card>
      <span class="metric-value">100%</span>
      <div class="metric-name">Out-of-scope refusal rate</div>
    </Card>

    <Card>
      <span class="metric-value">100%</span>
      <div class="metric-name">Legal detection accuracy</div>
    </Card>

    <Card tone="secondary">
      <span class="metric-value coverage-value">24%</span>
      <div class="metric-name">Retrieval coverage rate</div>
    </Card>
  </CardGrid>

  <Notice tone="warning">
    The 24% retrieval coverage reflects the intentionally small placeholder
    corpus used in the laboratory test. It is reported openly as a retrieval
    limitation and should not be interpreted as a production-readiness
    score.
  </Notice>

  <p class="disclaimer">
    This laboratory prototype is not a legal service, does not provide legal
    representation, and is not ready for production use.
  </p>

  <style>
    /*
     * Lab page-specific composition.
     * Purple = experimental / laboratory.
     * Orange = limitation / warning.
     */

    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 3rem;
    }

    h2 {
      margin: 3.5rem 0 1.25rem;
      color: var(--page-text);
      font-size: 2rem;
    }

    .metric-value {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--accent);
      font-family: Consolas, "Courier New", monospace;
      font-size: 2rem;
      font-weight: 700;
    }

    .coverage-value {
      color: var(--accent-secondary);
    }

    .metric-name {
      color: var(--page-muted);
      line-height: 1.5;
    }

    .disclaimer {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--page-border);
      color: var(--dark-note);
      font-size: 0.95rem;
      line-height: 1.6;
    }
  </style>
</PageLayout>