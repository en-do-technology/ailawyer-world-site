---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | AiLawyer.world"
  description="The requested page could not be found on AiLawyer.world."
  noindex={true}
>
  <main class="not-found">
    <div class="content">
      <div class="status">STATUS: PAGE_NOT_FOUND</div>

      <p class="code">404</p>

      <h1>This page could not be verified.</h1>

      <p class="message">
        The address may be incorrect, the page may have moved, or the requested
        material may not yet exist.
      </p>

      <a class="home-link" href="/">Return to AiLawyer.world</a>
    </div>
  </main>

  <style>
    .not-found {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 0;
      background:
        radial-gradient(circle at top right, var(--dark-glow-blue) 0, transparent 35%),
        var(--dark-bg-navy);
      color: var(--dark-text-soft);
      font-family: Arial, Helvetica, sans-serif;
    }

    .content {
      width: min(760px, 90%);
    }

    .status {
      display: inline-block;
      margin-bottom: 1.5rem;
      padding: 0.45rem 0.75rem;
      border: 1px solid var(--dark-orange);
      border-radius: 999px;
      color: var(--dark-orange);
      font-family: Consolas, "Courier New", monospace;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    .code {
      margin: 0;
      color: var(--dark-cyan);
      font-family: Consolas, "Courier New", monospace;
      font-size: clamp(5rem, 18vw, 10rem);
      font-weight: 700;
      line-height: 0.9;
    }

    h1 {
      margin: 1.5rem 0 1rem;
      font-size: clamp(2rem, 6vw, 3.5rem);
      line-height: 1.1;
    }

    .message {
      max-width: 620px;
      margin: 0;
      color: var(--dark-muted-blue);
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .home-link {
      display: inline-block;
      margin-top: 2rem;
      padding: 0.85rem 1.2rem;
      border: 1px solid var(--dark-cyan);
      border-radius: 0.5rem;
      color: var(--dark-text-soft);
      text-decoration: none;
      font-weight: 700;
      transition:
        background 160ms ease,
        color 160ms ease,
        transform 160ms ease;
    }

    .home-link:hover,
    .home-link:focus-visible {
      background: var(--dark-cyan);
      color: var(--dark-bg-navy);
      transform: translateY(-2px);
    }

    .home-link:focus-visible {
      outline: 2px solid var(--dark-text-soft);
      outline-offset: 3px;
    }
  </style>
</BaseLayout>