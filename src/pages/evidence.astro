---
import PageLayout from '../layouts/PageLayout.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
---

<PageLayout
  title="Evidence — AiLawyer.world"
  description="Documented evidence and historical milestones related to AiLawyer."
  canonical="https://ailawyer.world/evidence/"
  theme="dark"
  accent="evidence"
  eyebrow="DOCUMENTED HISTORY"
  heading="Evidence"
  lead="This page records verifiable milestones connected with the AiLawyer project and identity."
  width="standard"
>
  <CardGrid columns={1}>
    <Card
      title="Android package identity"
      headingLevel="h2"
    >
      <Badge slot="meta">SOURCE: VERIFIED</Badge>

      <p>
        The Android package identifier <strong>com.ailawyer</strong> was
        used for an AiLawyer application released through Google Play in
        June 2021.
      </p>
    </Card>

    <Card
      title="Historical position"
      headingLevel="h2"
    >
      <Badge slot="meta">CLAIM: LIMITED</Badge>

      <p>
        The project is presented as one of the earliest documented AI legal
        assistant applications and product identities. No claim of being
        the first in the world is made.
      </p>
    </Card>

    <Card
      title="AiLawyer name history"
      headingLevel="h2"
    >
      <Badge slot="meta">DOMAIN RECORD</Badge>

      <p>
        Historical domain records show that the name “AiLawyer” existed
        online before the modern generative-AI era.
      </p>
    </Card>
  </CardGrid>

  <section aria-labelledby="evidence-archive-heading">
    <h2 id="evidence-archive-heading">Evidence Archive</h2>
    <p>Original source records and evidence artifacts are provided for independent review.</p>
    <p><a href="/evidence/charter/">Read the Evidence Archive Charter</a></p>

    <CardGrid columns={1}>
      <Card title="E-001 — Google Play Package Verification" headingLevel="h3">
        <Badge slot="meta" tone="verified">SOURCE: GOOGLE PLAY CONSOLE</Badge>

        <p><strong>Source:</strong> Google Play Console</p>
        <p><strong>Scope:</strong> package identity, developer verification, signing fingerprint</p>
        <p><a href="/evidence/google-play/E-001-package-verification/">View evidence record</a></p>
        <p><a href="/evidence/google-play/E-001-package-verification.pdf" target="_blank" rel="noopener noreferrer">View original PDF</a></p>
      </Card>

      <Card title="E-002 — Google Play Production Release History" headingLevel="h3">
        <Badge slot="meta" tone="verified">SOURCE: GOOGLE PLAY CONSOLE</Badge>

        <p><strong>Source:</strong> Google Play Console</p>
        <p><strong>Scope:</strong> visible production release history</p>
        <p><strong>Date shown by source:</strong> June 9, 2021</p>
        <p><a href="/evidence/google-play/E-002-production-release-history/">View evidence record</a></p>
        <p><a href="/evidence/google-play/E-002-production-release-history.pdf" target="_blank" rel="noopener noreferrer">View original PDF</a></p>
      </Card>

      <Card title="E-003 — Google Play Release Details" headingLevel="h3">
        <Badge slot="meta" tone="verified">SOURCE: GOOGLE PLAY CONSOLE</Badge>

        <p><strong>Source:</strong> Google Play Console</p>
        <p><strong>Scope:</strong> release details, App Bundle metadata, availability</p>
        <p><a href="/evidence/google-play/E-003-release-details/">View evidence record</a></p>
        <p><a href="/evidence/google-play/E-003-release-details.pdf" target="_blank" rel="noopener noreferrer">View original PDF</a></p>
      </Card>
    </CardGrid>
  </section>

  <p class="evidence-note">
    Evidence should be supported by documents, platform records, archived
    pages, screenshots, or other independently reviewable materials.
  </p>

  <style>
    /*
     * Evidence page-specific composition.
     * All colors come from AiLawyer Design System tokens.
     */

    .evidence-note {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--page-border);
      color: var(--dark-note);
      font-size: 0.95rem;
      line-height: 1.6;
    }
  </style>
</PageLayout>
