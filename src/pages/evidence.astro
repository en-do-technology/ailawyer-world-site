---
import PageLayout from '../layouts/PageLayout.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
---

<PageLayout
  title="Evidence — AiLawyer.world"
  description="Documented evidence and historical milestones related to AiLawyer."
  canonical="https://ailawyer.world/evidence/"
  theme="dark"
  accent="evidence"
  eyebrow="DOCUMENTED HISTORY"
  heading="Evidence"
  lead="This page records verifiable milestones connected with the AiLawyer project and identity."
  width="standard"
>
  <CardGrid columns={1}>
    <Card
      title="Android package identity"
      headingLevel="h2"
    >
      <Badge slot="meta">SOURCE: VERIFIED</Badge>

      <p>
        The Android package identifier <strong>com.ailawyer</strong> was
        used for an AiLawyer application released through Google Play in
        June 2021.
      </p>
    </Card>

    <Card
      title="Historical position"
      headingLevel="h2"
    >
      <Badge slot="meta">CLAIM: LIMITED</Badge>

      <p>
        The project is presented as one of the earliest documented AI legal
        assistant applications and product identities. No claim of being
        the first in the world is made.
      </p>
    </Card>

    <Card
      title="AiLawyer name history"
      headingLevel="h2"
    >
      <Badge slot="meta">DOMAIN RECORD</Badge>

      <p>
        Historical domain records show that the name “AiLawyer” existed
        online before the modern generative-AI era.
      </p>
    </Card>
  </CardGrid>

  <p class="evidence-note">
    Evidence should be supported by documents, platform records, archived
    pages, screenshots, or other independently reviewable materials.
  </p>

  <style>
    /*
     * Evidence page-specific composition.
     * All colors come from AiLawyer Design System tokens.
     */

    .evidence-note {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--page-border);
      color: var(--dark-note);
      font-size: 0.95rem;
      line-height: 1.6;
    }
  </style>
</PageLayout>