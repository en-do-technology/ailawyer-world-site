---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Impressum — AiLawyer.world"
  description="Legal provider information for AiLawyer.world and EN-DO Technology."
  canonical="https://ailawyer.world/impressum/"
  theme="paper"
  accent="legal"
  eyebrow="LEGAL PROVIDER INFORMATION"
  heading="Impressum"
  lead="Provider identification and contact information for AiLawyer.world."
  width="article"
>
  <section>
    <h2>Anbieter gemäß § 5 DDG</h2>

    <address>
      Anton Vibe<br />
      handelnd unter der Bezeichnung EN-DO Technology<br />
      <br />
      Kölpiner Str. 3<br />
      12689 Berlin<br />
      Deutschland<br />
      <br />
      E-Mail: <a href="mailto:sarverein@gmail.com">sarverein@gmail.com</a>
    </address>
  </section>

  <section>
    <h2>
      Verantwortlich für journalistisch-redaktionelle Inhalte<br />
      gemäß § 18 Abs. 2 MStV:
    </h2>

    <address>
      Anton Vibe<br />
      Anschrift wie oben
    </address>
  </section>

  <section>
    <h2>Project status</h2>

    <p>
      AiLawyer.world is an experimental legal-AI research and information
      project. It is not a law firm and does not provide legal
      representation.
    </p>
  </section>

  <style>
    /*
     * Impressum is the reference page for the
     * Paper / Legal family.
     * No raw colors are stored in this page.
     */

    section {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--page-border);
    }

    h2 {
      margin: 0 0 1rem;
      color: var(--page-text);
      font-size: 1.5rem;
    }

    p {
      margin: 0;
      line-height: 1.75;
    }

    address {
      font-style: normal;
      line-height: 1.75;
    }

    a {
      color: var(--page-link);
    }
  </style>
</PageLayout>
