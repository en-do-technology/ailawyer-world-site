---
import PageLayout from '../layouts/PageLayout.astro';
import Badge from '../components/Badge.astro';
import Notice from '../components/Notice.astro';
---

<PageLayout
  title="Impressum — AiLawyer.world"
  description="Legal provider information for AiLawyer.world and EN-DO Technology."
  canonical="https://ailawyer.world/impressum/"
  theme="paper"
  accent="legal"
  eyebrow="LEGAL PROVIDER INFORMATION"
  heading="Impressum"
  lead="Provider identification and contact information for AiLawyer.world."
  width="article"
>
  <div slot="pre-heading" class="status-row">
    <Badge>STATUS: DRAFT</Badge>
  </div>

  <div class="legal-warning">
    <Notice tone="warning">
      This page is currently a development placeholder. The required provider
      information must be completed and legally reviewed before public launch.
    </Notice>
  </div>

  <section>
    <h2>Provider</h2>

    <address>
      <span class="placeholder">[FULL LEGAL NAME]</span><br />
      EN-DO Technology<br />
      <span class="placeholder">[STREET AND HOUSE NUMBER]</span><br />
      <span class="placeholder">[POSTAL CODE AND CITY]</span><br />
      Germany
    </address>
  </section>

  <section>
    <h2>Contact</h2>

    <p>
      Email:
      <span class="placeholder">[CONTACT EMAIL]</span>
    </p>
  </section>

  <section>
    <h2>Responsible for content</h2>

    <address>
      <span class="placeholder">[RESPONSIBLE PERSON]</span><br />
      <span class="placeholder">[ADDRESS, IF REQUIRED]</span>
    </address>
  </section>

  <section>
    <h2>Project status</h2>

    <p>
      AiLawyer.world is an experimental legal-AI research and information
      project. It is not a law firm and does not provide legal
      representation.
    </p>
  </section>

  <style>
    /*
     * Impressum is the reference page for the
     * Paper / Legal family.
     * No raw colors are stored in this page.
     */

    .status-row {
      margin-bottom: 1.5rem;
    }

    /*
     * Preserve the warmer warning character
     * of the original Impressum design.
     */
    .legal-warning {
      --accent-secondary: var(--paper-orange);
      --page-muted: var(--paper-orange-text);
      margin-bottom: 2.5rem;
    }

    section {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--page-border);
    }

    h2 {
      margin: 0 0 1rem;
      color: var(--page-text);
      font-size: 1.5rem;
    }

    p {
      margin: 0;
      line-height: 1.75;
    }

    address {
      font-style: normal;
      line-height: 1.75;
    }

    .placeholder {
      color: var(--accent-secondary);
      font-family: Consolas, "Courier New", monospace;
      font-weight: 700;
    }

    a {
      color: var(--page-link);
    }
  </style>
</PageLayout>