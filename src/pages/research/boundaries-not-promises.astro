  </style>

  <script>
    const canonicalUrl = 'https://ailawyer.world/research/boundaries-not-promises/';
    const shareTitle = 'Why Legal AI Should Start With Boundaries, Not Promises';

    const copyLink = async () => {
      await navigator.clipboard.writeText(canonicalUrl);
    };

    document.querySelectorAll('[data-share-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const panel = button.closest('.share-panel');
        const feedback = panel?.querySelector('.share-feedback');
        try {
          await copyLink();
          if (feedback) feedback.textContent = 'Link copied';
        } catch {
          if (feedback) feedback.textContent = 'Copy unavailable — copy the article URL manually.';
        }
      });
    });

    document.querySelectorAll('[data-share-substack]').forEach((link) => {
      link.addEventListener('click', async (event) => {
        event.preventDefault();
        window.open(link.href, '_blank', 'noopener,noreferrer');
        const panel = link.closest('.share-panel');
        const feedback = panel?.querySelector('.share-feedback');
        try {
          await copyLink();
          if (feedback) feedback.textContent = 'Link copied — paste it into a Substack Note.';
        } catch {
          if (feedback) feedback.textContent = 'Copy unavailable — paste the article URL into a Substack Note.';
        }
      });
    });

    document.querySelectorAll('[data-share-native]').forEach((button) => {
      if (typeof navigator.share !== 'function') return;
      button.hidden = false;
      button.addEventListener('click', async () => {
        const panel = button.closest('.share-panel');
        const feedback = panel?.querySelector('.share-feedback');
        try {
          await navigator.share({ title: shareTitle, url: canonicalUrl });
        } catch (error) {
          if (error?.name !== 'AbortError' && feedback) feedback.textContent = 'Sharing unavailable.';
        }
      });
    });
  </script>
</PageLayout>
